# Frontend Environment Variables (Vite)
# Vite only exposes variables prefixed with VITE_ to the browser

# API Base URL:
# - Leave as /api (default) to let Vite dev proxy handle requests to http://127.0.0.1:5001
# - Or set to full backend URL if connecting directly (e.g. http://localhost:5001/api)
VITE_API_URL=/api
